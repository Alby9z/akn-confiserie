# ─────────────────────────────────────────────────────────────
# AKN Confiserie 90 — variables d'environnement
# Copiez ce fichier en « .env » et remplissez les valeurs.
# Ne commitez JAMAIS le fichier .env (il est exclu par .gitignore).
# ─────────────────────────────────────────────────────────────

# Base PostgreSQL
DATABASE_URL="postgresql://akn:MOT_DE_PASSE@localhost:5432/akn_confiserie"

# Adresse publique du site (sans / final). En local : http://localhost:3000
APP_URL="http://localhost:3000"

# Secret de signature des sessions : 32 caractères aléatoires minimum.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""

# Stripe (tableau de bord Stripe → Développeurs → Clés API). Clés de TEST : sk_test_…
# Obligatoires en production. Sans elles en local, la commande en ligne reste fermée.
STRIPE_SECRET_KEY=""
# Secret du webhook (stripe listen en local, ou tableau de bord Stripe en production) : whsec_…
STRIPE_WEBHOOK_SECRET=""

# Resend (resend.com → API Keys). Obligatoire en production.
# Sans clé en local, les e-mails sont affichés dans la console et NON envoyés.
RESEND_API_KEY=""
# Expéditeur : doit utiliser un domaine vérifié chez Resend en production
EMAIL_FROM="AKN Confiserie 90 <commandes@votre-domaine.fr>"
# Adresse qui reçoit les nouvelles commandes, demandes de devis et demandes de suppression
ADMIN_NOTIFICATION_EMAIL=""

# Dossier de stockage des photos produits et pièces jointes (hors du dossier public)
STORAGE_DIR="./storage"

# Facultatif : code de vérification Google Search Console (balise meta)
GOOGLE_SITE_VERIFICATION=""
